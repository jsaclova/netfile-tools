#!/bin/bash
# ===============================================
# Name: netget
# Author: Jin (jsaclova@gmail.com)
# Date: 2026-09-21
# Description: Interactive Remote File/Folder Pull Tool with Fixed 0-Quit
# ===============================================

# 고정 설정 경로
TOOL_DIR="$HOME/bin/netfile-tools"
LIST_FILE="$TOOL_DIR/target_list.txt"
LOG_DIR="$TOOL_DIR/log"

# 일자별 로그 파일명 설정 (형식: transfer_년-월-일.log)
CURRENT_DATE=$(date "+%Y-%m-%d")
LOG_FILE="$LOG_DIR/transfer_${CURRENT_DATE}.log"

# 로그 폴더 사전 생성 보장
mkdir -p "$LOG_DIR" 2>/dev/null

clear
echo "============================================================"
echo " ▶️ Program     : netget"
echo " ▶️ Author      : Jin (jsaclova@gmail.com)"
echo " ▶️ Description : Interactive Remote File/Folder Pull Tool"
echo "============================================================"
echo "  This tool guides you step-by-step to GET files or folders"
echo "  from another computer on the same network using SSH/rsync."
echo "============================================================"
echo ""

# ------------------------------------------------------------
# STEP 1: 주소록을 파싱하여 원격 기기 선택받기 (0번 고정 패치)
# ------------------------------------------------------------
echo "📌 STEP 1: Select the source computer from the list."
if [ ! -f "$LIST_FILE" ]; then
    echo "❌ Error: Address book file ($LIST_FILE) not found."
    echo "============================================================"
    exit 1
fi
echo "------------------------------------------------------------"

lines=()
index=1
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue
    
    raw_name=$(echo "$line" | awk '{print $1}')
    raw_user=$(echo "$line" | awk '{print $2}')
    raw_ip=$(echo "$line" | awk '{print $3}')
    
    clean_user=${raw_user#User:}
    clean_ip=${raw_ip#IP:}
    
    printf "   [%d] %-8s (User: %-8s / IP: %s)\n" "$index" "$raw_name" "$clean_user" "$clean_ip"
    
    lines+=("$raw_name $clean_user $clean_ip")
    index=$((index + 1))
done < "$LIST_FILE"

TOTAL_TARGETS=$((index - 1))

# [핵심 고정] 주소록 개수와 상관없이 종료 메뉴 번호를 무조건 '0'번으로 상시 고정 인쇄
printf "   Exit and Cancel (Return to local Mac terminal)\n"

if [ "$TOTAL_TARGETS" -eq 0 ]; then
    echo "⚪️ Notice: No valid hosts found in target_list.txt."
    echo "============================================================"
    exit 1
fi

echo "------------------------------------------------------------"
read -p "👉 Enter number (1-$TOTAL_TARGETS or '0' to quit): " CHOICE
echo "------------------------------------------------------------"

# 0번 혹은 탈출 텍스트 입력 시 즉시 안전 종료
if [ "$CHOICE" == "0" ] || [ "$CHOICE" == "q" ] || [ "$CHOICE" == "quit" ] || [ "$CHOICE" == "exit" ] || [ -z "$CHOICE" ]; then
    echo " 🚪 Cancelled at Step 1. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "$TOTAL_TARGETS" ]; then
    echo "❌ Error: Invalid selection number. Canceling download."
    echo "============================================================"
    exit 1
fi

SELECTED_DATA="${lines[$((CHOICE - 1))]}"
TARGET_NAME=$(echo "$SELECTED_DATA" | awk '{print $1}')
TARGET_USER=$(echo "$SELECTED_DATA" | awk '{print $2}')
TARGET_IP=$(echo "$SELECTED_DATA" | awk '{print $3}')
echo "🟢 Source selected: $TARGET_NAME"
echo ""

# ------------------------------------------------------------
# STEP 2: 상대방 컴퓨터의 가져올 파일/폴더 경로 입력받기
# ------------------------------------------------------------
echo "📌 STEP 2: Enter the remote path of the file or folder to GET."
read -p "👉 Remote Path (or '0' to quit): " REMOTE_SRC_PATH

if [ "$REMOTE_SRC_PATH" == "0" ] || [ "$REMOTE_SRC_PATH" == "q" ] || [ "$REMOTE_SRC_PATH" == "quit" ] || [ "$REMOTE_SRC_PATH" == "exit" ]; then
    echo "------------------------------------------------------------"
    echo " 🚪 Cancelled at Step 2. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if [ -z "$REMOTE_SRC_PATH" ]; then
    echo "❌ Error: Remote path cannot be empty. Canceling download."
    echo "============================================================"
    exit 1
fi
echo "🟢 Remote target path locked."
echo ""

# ------------------------------------------------------------
# STEP 3: 내 컴퓨터의 저장 위치 지정받기
# ------------------------------------------------------------
echo "📌 STEP 3: Enter the local path to save the file/folder."
echo "   (Press [Enter] to use default fallback: ~/Downloads)"
read -p "👉 Local Path (or '0' to quit): " LOCAL_DEST_PATH

if [ "$LOCAL_DEST_PATH" == "0" ] || [ "$LOCAL_DEST_PATH" == "q" ] || [ "$LOCAL_DEST_PATH" == "quit" ] || [ "$LOCAL_DEST_PATH" == "exit" ]; then
    echo "------------------------------------------------------------"
    echo " 🚪 Cancelled at Step 3. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if [ -z "$LOCAL_DEST_PATH" ]; then
    LOCAL_DEST_PATH="$HOME/Downloads"
fi

LOCAL_DEST_PATH=$(echo "$LOCAL_DEST_PATH" | sed -e "s/^'//" -e "s/'$//" -e 's/^"//' -e 's/"$//' -e 's/[[:space:]]*$//' | sed 's/\/$//')

# START DOWNLOAD
START_TIME=$(date +%s)
SSH_OPTS="ssh -o NumberOfPasswordPrompts=3 -o KbdInteractiveAuthentication=no -o PreferredAuthentications=password"

# 상세 에러 로그 마스킹 격리 처리 수신
RSYNC_ERR_LOG=$(rsync -avzh --progress -e "$SSH_OPTS" "${TARGET_USER}@${TARGET_IP}:${REMOTE_SRC_PATH}" "$LOCAL_DEST_PATH" 2>&1)
RSYNC_STATUS=$?

END_TIME=$(date +%s)
ELAPSED_SECONDS=$((END_TIME - START_TIME))
FORMATTED_TIME="${ELAPSED_SECONDS}s"

# LOGGING
if [ $RSYNC_STATUS -eq 0 ]; then
    echo "$RSYNC_ERR_LOG"
    echo "------------------------------------------------------------"
    echo "✨ Success! Download completed successfully. (Time: $FORMATTED_TIME)"
    
    TARGET_BASE_NAME=$(basename "$REMOTE_SRC_PATH")
    if [ -d "$LOCAL_DEST_PATH" ]; then
        FINAL_CHECK_PATH="${LOCAL_DEST_PATH}/${TARGET_BASE_NAME}"
    else
        FINAL_CHECK_PATH="$LOCAL_DEST_PATH"
    fi

    if [ -d "$FINAL_CHECK_PATH" ]; then
        DOWNLOADED_LIST=$(find "$FINAL_CHECK_PATH" -type f 2>/dev/null)
    else
        DOWNLOADED_LIST="$FINAL_CHECK_PATH"
    fi

    echo "$DOWNLOADED_LIST" | while read -r single_file; do
        [ -z "$single_file" ] && continue
        echo "[$(date '+%H:%M:%S')] [GET_SUCCESS] File: $single_file" >> "$LOG_FILE"
        echo "           └─ From: $TARGET_NAME($TARGET_IP) -> '$REMOTE_SRC_PATH' | Time: $FORMATTED_TIME" >> "$LOG_FILE"
    done
else
    echo "------------------------------------------------------------"
    echo "❌ 보안 알림: 패스워드 3회 실패로 인해 접속이 강제 종료되었습니다."
    echo "[$(date '+%H:%M:%S')] [GET_FAIL] Remote: $TARGET_NAME($TARGET_IP) -> Path: $REMOTE_SRC_PATH" >> "$LOG_FILE"
    echo "           └─ Local Save: $LOCAL_DEST_PATH | Time: $FORMATTED_TIME (SSH Error/3-Pass Limit)" >> "$LOG_FILE"
fi
echo "============================================================"

#!/bin/bash

echo "============================================================"
echo "          📂 netfile-tools Independent Installation"
echo "============================================================"
echo " 💡 Connecting to remote GitHub repository..."
echo "------------------------------------------------------------"

# 1. 사용자 bin 폴더 생성 및 진입
mkdir -p "\$HOME/bin"
cd "\$HOME/bin" || exit 1

# 2. 기존 동일 폴더 존재 시 안전하게 선 제거
if [ -d "./netfile-tools" ]; then
    rm -rf "./netfile-tools"
fi

# 3. 깃허브 단독 저장소로부터 소스코드 직접 다운로드 (Clone)
git clone git@github.com:jsaclova/netfile-tools.git

if [ \$? -ne 0 ]; then
    echo " ❌ Error: Failed to clone repository from GitHub."
    echo "    Please verify your SSH key configuration or repository URL."
    echo "============================================================"
    exit 1
fi

# 4. 맥 터미널 설정 파일(~/.zshrc)에 명령어 경로(PATH) 중복 체크 후 등록
ZSHRC="\$HOME/.zshrc"
if ! grep -q "netfile-tools" "\$ZSHRC" 2>/dev/null; then
    echo 'export PATH="\$HOME/bin/netfile-tools:PATH"' >> "ZSHRC"
    echo " ✅ Added executing PATH to ~/.zshrc"
else
    echo " ℹ️ PATH already exists in ~/.zshrc. Skipping."
fi

# 5. 실행 권한 부여
chmod +x "\$HOME/bin/netfile-tools/"* 2>/dev/null

echo "------------------------------------------------------------"
echo " ✨ Installation Completed Successfully!"
echo " 💡 Please open a new terminal window or run the following command:"
echo "    source ~/.zshrc"
echo " 💡 Try running 'netsend' or 'netget' anywhere!"
echo "============================================================"

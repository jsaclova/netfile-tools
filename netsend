#!/bin/bash
# ===============================================
# Name: netsend
# Author: Jin (jsaclova@gmail.com)
# Date: 2026-09-21
# Description: Interactive Remote File/Folder Transfer Tool with 1-Step Quit Option
# ===============================================

# 고정 설정 경로
TOOL_DIR="$HOME/bin/netfile-tools"
LIST_FILE="$TOOL_DIR/target_list.txt"
LOG_DIR="$TOOL_DIR/log"

# 일자별 로그 파일명 설정 (형식: transfer_년-월-일.log)
CURRENT_DATE=$(date "+%Y-%m-%d")
LOG_FILE="$LOG_DIR/transfer_${CURRENT_DATE}.log"

# 로그 폴더 사전 생성 보장
mkdir -p "$LOG_DIR" 2>/dev/null

clear
echo "============================================================"
echo " ▶️ Program     : netsend"
echo " ▶️ Author      : Jin (jsaclova@gmail.com)"
echo " ▶️ Description : Interactive Remote File/Folder Transfer Tool"
echo "============================================================"
echo "  This tool guides you step-by-step to send files or folders"
echo "  to another computer on the same network using SSH/rsync."
echo "============================================================"
echo ""

# ------------------------------------------------------------
# STEP 1: 보낼 파일 또는 폴더 경로 입력받기 (0번 취소 안내 추가)
# ------------------------------------------------------------
echo "📌 STEP 1: Enter the path of the file or folder to send."
echo "   (You can drag and drop the file/folder into this terminal window)"
read -p "👉 Path (or '0' to quit): " SRC_PATH

# 드래그 앤 드롭 시 양끝에 붙는 따옴표나 공백 제거 가공
SRC_PATH=$(echo "$SRC_PATH" | sed -e "s/^'//" -e "s/'$//" -e 's/^"//' -e 's/"$//' -e 's/[[:space:]]*$//')

# [핵심 패치] 1단계 경로 입력창에서 0, q, quit, exit 입력 시 즉시 취소 종료
if [ "$SRC_PATH" == "0" ] || [ "$SRC_PATH" == "q" ] || [ "$SRC_PATH" == "quit" ] || [ "$SRC_PATH" == "exit" ] || [ -z "$SRC_PATH" ]; then
    echo "------------------------------------------------------------"
    echo " 🚪 Cancelled at Step 1. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if [ ! -e "$SRC_PATH" ]; then
    echo "❌ Error: File or folder does not exist at that path."
    echo "============================================================"
    exit 1
fi
echo "🟢 Valid source path verified."
echo ""

# ------------------------------------------------------------
# STEP 2: 주소록을 파싱하여 목적지 선택받기
# ------------------------------------------------------------
echo "📌 STEP 2: Select the destination computer from the list."
if [ ! -f "$LIST_FILE" ]; then
    echo "❌ Error: Address book file ($LIST_FILE) not found."
    echo "============================================================"
    exit 1
fi
echo "------------------------------------------------------------"

lines=()
index=1
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue
    
    raw_name=$(echo "$line" | awk '{print $1}')
    raw_user=$(echo "$line" | awk '{print $2}')
    raw_ip=$(echo "$line" | awk '{print $3}')
    
    clean_user=${raw_user#User:}
    clean_ip=${raw_ip#IP:}
    
    printf "   [%d] %-8s (User: %-8s / IP: %s)\n" "$index" "$raw_name" "$clean_user" "$clean_ip"
    
    lines+=("$raw_name $clean_user $clean_ip")
    index=$((index + 1))
done < "$LIST_FILE"

TOTAL_TARGETS=$((index - 1))

printf "   [%d] Exit and Cancel (Return to local Mac terminal)\n" "$index"

if [ "$TOTAL_TARGETS" -eq 0 ]; then
    echo "⚪️ Notice: No valid hosts found in target_list.txt."
    echo "============================================================"
    exit 1
fi

echo "------------------------------------------------------------"
read -p "👉 Enter number (1-$TOTAL_TARGETS or '$index'/'0' to quit): " CHOICE
echo "------------------------------------------------------------"

# 2단계 종료 옵션 처리 (0번 또는 목록 끝번호 선택 시 종료)
if [ "$CHOICE" == "0" ] || [ "$CHOICE" == "$index" ] || [ "$CHOICE" == "q" ] || [ "$CHOICE" == "quit" ] || [ "$CHOICE" == "exit" ]; then
    echo " 🚪 Cancelled at Step 2. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "$TOTAL_TARGETS" ]; then
    echo "❌ Error: Invalid selection number. Canceling transfer."
    echo "============================================================"
    exit 1
fi

SELECTED_DATA="${lines[$((CHOICE - 1))]}"
TARGET_NAME=$(echo "$SELECTED_DATA" | awk '{print $1}')
TARGET_USER=$(echo "$SELECTED_DATA" | awk '{print $2}')
TARGET_IP=$(echo "$SELECTED_DATA" | awk '{print $3}')
echo "🟢 Target selected: $TARGET_NAME"
echo ""

# ------------------------------------------------------------
# STEP 3: 목적지 저장 위치 입력받기
# ------------------------------------------------------------
echo "📌 STEP 3: Enter the destination folder path on the remote machine."
echo "   (Press [Enter] to use default fallback: ~/Downloads/)"
read -p "👉 Remote Path (or '0' to quit): " DEST_PATH

if [ "$DEST_PATH" == "0" ] || [ "$DEST_PATH" == "q" ] || [ "$DEST_PATH" == "quit" ] || [ "$DEST_PATH" == "exit" ]; then
    echo "------------------------------------------------------------"
    echo " 🚪 Cancelled at Step 3. Safely returned to Mac terminal."
    echo "============================================================"
    exit 0
fi

if [ -z "$DEST_PATH" ]; then
    DEST_PATH="~/Downloads/"
fi
echo "🟢 Target path set to: $DEST_PATH"
echo ""

# START TRANSFER
if [ "$SRC_PATH" == "." ] || [ "$SRC_PATH" == "./" ]; then
    ABS_SRC_ROOT=$(pwd)
else
    if [[ "$SRC_PATH" = /* ]]; then
        ABS_SRC_ROOT="$SRC_PATH"
    else
        ABS_SRC_ROOT="$(cd "$(dirname "$SRC_PATH")" 2>/dev/null && pwd)/$(basename "$SRC_PATH")"
    fi
fi

START_TIME=$(date +%s)

echo "🔍 Checking connection to [$TARGET_NAME] ($TARGET_IP)..."
if ! ping -c 1 -W 2 "$TARGET_IP" &>/dev/null; then
    echo "❌ Error: Cannot communicate with $TARGET_NAME. Host is offline."
    END_TIME=$(date +%s)
    ELAPSED=$((END_TIME - START_TIME))
    
    echo "[$(date '+%H:%M:%S')] [SEND_FAIL] File: $ABS_SRC_ROOT" >> "$LOG_FILE"
    echo "           └─ To: $TARGET_NAME($TARGET_IP) -> '$DEST_PATH' | Time: ${ELAPSED}s (Offline)" >> "$LOG_FILE"
    echo "============================================================"
    exit 1
fi

echo "🟢 Online! Initializing secure file transfer..."
echo " 🔒 Strict Security Active: Auto-close session after 3 password failures."
echo "------------------------------------------------------------"

SSH_OPTS="ssh -o NumberOfPasswordPrompts=3 -o KbdInteractiveAuthentication=no -o PreferredAuthentications=password"
RSYNC_ERR_LOG=$(rsync -avzh --progress -e "$SSH_OPTS" "${SRC_PATH%/}" "${TARGET_USER}@${TARGET_IP}:${DEST_PATH}" 2>&1)
RSYNC_STATUS=$?

END_TIME=$(date +%s)
ELAPSED_SECONDS=$((END_TIME - START_TIME))

FORMATTED_TIME=""
if [ $ELAPSED_SECONDS -ge 3600 ]; then
    FORMATTED_TIME="$((ELAPSED_SECONDS / 3600))h $(((ELAPSED_SECONDS % 3600) / 60))m $((ELAPSED_SECONDS % 60))s"
elif [ $ELAPSED_SECONDS -ge 60 ]; then
    FORMATTED_TIME="$((ELAPSED_SECONDS / 60))m $((ELAPSED_SECONDS % 60))s"
else
    FORMATTED_TIME="${ELAPSED_SECONDS}s"
fi

# LOGGING
if [ $RSYNC_STATUS -eq 0 ]; then
    echo "$RSYNC_ERR_LOG"
    echo "------------------------------------------------------------"
    echo "✨ Success! Transfer completed successfully. (Time: $FORMATTED_TIME)"
    echo "💾 Saved Location: $TARGET_USER@$TARGET_IP:$DEST_PATH"
    
    if [ -d "$ABS_SRC_ROOT" ]; then
        TRANSFER_FILES=$(find "$ABS_SRC_ROOT" -type f 2>/dev/null)
    else
        TRANSFER_FILES="$ABS_SRC_ROOT"
    fi

    echo "$TRANSFER_FILES" | while read -r single_file; do
        [ -z "$single_file" ] && continue
        single_file=$(echo "$single_file" | sed 's/\/\/*/\//g')

        echo "[$(date '+%H:%M:%S')] [SEND_SUCCESS] File: $single_file" >> "$LOG_FILE"
        echo "           └─ To: $TARGET_NAME($TARGET_IP) -> '$DEST_PATH' | Time: $FORMATTED_TIME" >> "$LOG_FILE"
    done
else
    echo "------------------------------------------------------------"
    echo "❌ 보안 알림: 패스워드 3회 실패로 인해 접속이 강제 종료되었습니다."
    
    echo "[$(date '+%H:%M:%S')] [SEND_FAIL] File: $ABS_SRC_ROOT" >> "$LOG_FILE"
    echo "           └─ To: $TARGET_NAME($TARGET_IP) -> '$DEST_PATH' | Time: $FORMATTED_TIME (SSH Error/3-Pass Limit)" >> "$LOG_FILE"
fi

echo "============================================================"
